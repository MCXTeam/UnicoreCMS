# Документация: https://unicore.uno/docs/settings/env

# --- Проект ---
# Имя проекта [string]
SITENAME=UnicoreCMS
# Базовый URL клиента (публичный сайт), напр. https://example.com [string, обязательно]
BASEURL=http://127.0.0.1:3000
# Базовый URL API-сервера, напр. https://api.example.com [string, обязательно]
API_BASEURL=http://127.0.0.1:5000

# --- Порты процессов ---
CLIENT_PORT=3000
ADMIN_PORT=4000
SERVER_PORT=5000

# --- База данных (mysql | mariadb | postgres) ---
DATABASE_TYPE=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=unicore
DATABASE_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_NAME=unicore

# --- Безопасность ---
# Подпись JWT (ОБЯЗАТЕЛЬНО заменить: >= 32 симв., напр. `openssl rand -hex 32`)
JWT_KEY=CHANGE_ME_long_random_secret_min_32_chars
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Доверенные прокси для реального IP клиента. Пусто/false = socket-адрес.
# За обратным прокси (nginx на localhost) укажите: loopback (или IP/подсеть прокси / число хопов).
TRUST_PROXY=
# Разрешённые CORS-источники через запятую (пусто = только BASEURL)
CORS_ORIGINS=

# --- Тема по умолчанию (light | dark | system) ---
COLOR_MODE_PREFERENCE=light
COLOR_MODE_FALLBACK=light

# --- Recaptcha v3 (пусто = отключено) ---
RECAPTCHA_PUBLIC=
RECAPTCHA_SECRET=

# --- SMTP (почта) ---
MAIL_FROM=no-reply@example.com
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Точность валют (знаков после запятой) ---
REAL_DECIMALS=2
VIRTUAL_DECIMALS=2
INGAME_DECIMALS=2

# --- Docker: MariaDB + домены для nginx-профиля ---
MYSQL_DATABASE=unicore
MYSQL_USER=unicore
MYSQL_PASSWORD=CHANGE_ME_strong_db_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
CLIENT_HOST=example.com
ADMIN_HOST=admin.example.com
SERVER_HOST=api.example.com

# --- Опциональные интеграции (заполнять по необходимости) ---
# Платёжные провайдеры: UNITPAY_*, FREEKASSA_*, ENOTIO_*, PAYOK_*, ANYPAY_*, CENTAPP_*
# Мониторинги голосований: MCTOP_*, MCRATE_*, TOPCRAFT_*, MINECRAFTRATING_*
# Соцсети/аналитика: VK_APIKEY, DISCORD_CLIENT_ID/SECRET, GOOGLE_ANALYTICS_ID, YANDEX_METRIKA_ID

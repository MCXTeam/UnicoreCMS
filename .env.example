# Документация: https://unicore.uno/docs/settings/env
#
# Большинство переменных применяются перезапуском приложений, без повторной сборки.
# Пересборка фронтов нужна только для: GOOGLE_ANALYTICS_ID, YANDEX_METRIKA_ID,
# COLOR_MODE_PREFERENCE, COLOR_MODE_FALLBACK — они подключают модули и темы на этапе сборки.

# --- Проект ---
# Имя проекта [string]
SITENAME=UnicoreCMS
# Базовый URL клиента (публичный сайт), напр. https://example.com [string, обязательно]
BASEURL=http://127.0.0.1:3000
# Базовый URL API-сервера, напр. https://api.example.com [string, обязательно]
API_BASEURL=http://127.0.0.1:5000
# Базовый URL админ-панели, напр. https://admin.example.com [string]
# Пусто = BASEURL с портом ADMIN_PORT. Нужен серверу, чтобы разрешить админке CORS.
ADMIN_BASEURL=

# --- Время ---
# Таймзона проекта (IANA, напр. Europe/Moscow). В ней время пишется в БД и показывается на сайте.
# UTC — рекомендуемое значение: не зависит от переводов часов и переноса сервера.
TIMEZONE=UTC

# --- Порты процессов ---
# Значения из этого файла имеют приоритет над переменными окружения:
# игровые панели (Pterodactyl и др.) занимают имя SERVER_PORT под свою аллокацию.
# BACKEND_PORT — новое имя вместо SERVER_PORT (старое ещё читается для совместимости).
CLIENT_PORT=3000
ADMIN_PORT=4000
BACKEND_PORT=5000

# --- База данных (mysql | mariadb) ---
DATABASE_TYPE=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=unicore
DATABASE_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_NAME=unicore

# --- Безопасность ---
# Подпись JWT (ОБЯЗАТЕЛЬНО заменить: >= 32 симв., напр. `openssl rand -hex 32`)
JWT_KEY=CHANGE_ME_long_random_secret_min_32_chars

# Ключ шифрования данных: хеши паролей, RCON-пароли, 2FA-секреты (`openssl rand -hex 32`).
# Держать ОТДЕЛЬНО от JWT_KEY: разные назначения — разные секреты.
# Пусто = берётся JWT_KEY, и тогда смена JWT_KEY без переноса старого значения
# в ENCRYPTION_KEY_PREVIOUS закроет вход всем. В production переменная обязательна.
# ПОТЕРЯ КЛЮЧА = никто не сможет войти, а RCON-пароли и 2FA-секреты не расшифруются.
# Ротация: старый ключ положить в ENCRYPTION_KEY_PREVIOUS, новый — в ENCRYPTION_KEY,
# затем `pnpm --filter unicore-server exec node dist/cli/main.js crypto-rewrap`
# (пароли перешифруются сами при следующем входе). После — ENCRYPTION_KEY_PREVIOUS очистить.
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# --- Хеширование паролей ---
# argon2id (по умолчанию) или bcrypt. Старые хеши читаются в любом случае и
# перехешируются на текущий алгоритм при следующем успешном входе.
PASSWORD_ALGORITHM=argon2id
# Параметры argon2id: память в КиБ, итерации, потоки
PASSWORD_ARGON2_MEMORY=65536
PASSWORD_ARGON2_TIME=3
PASSWORD_ARGON2_PARALLELISM=4
# Цена bcrypt (используется, если PASSWORD_ALGORITHM=bcrypt)
PASSWORD_BCRYPT_COST=12
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Доверенные прокси для реального IP клиента. Пусто/false = socket-адрес.
# За обратным прокси УКАЗАТЬ ОБЯЗАТЕЛЬНО, иначе все клиенты выглядят одним IP:
# ломаются троттлинг, антифлуд сброса пароля, IP-allowlist API-ключей и платёжных вебхуков.
# docker-compose с профилем nginx: 1 (один доверенный хоп). nginx на localhost: loopback.
# Оставлять пустым можно только если приложение смотрит в интернет напрямую —
# иначе клиент сможет подделать свой IP заголовком X-Forwarded-For.
TRUST_PROXY=
# Разрешённые CORS-источники через запятую (пусто = BASEURL + ADMIN_BASEURL)
CORS_ORIGINS=

# --- Тема по умолчанию (light | dark | system) ---
COLOR_MODE_PREFERENCE=light
COLOR_MODE_FALLBACK=light

# --- Recaptcha v3 ---
# Пустой секрет снимает капчу с входа, регистрации и сброса пароля.
# В production это ошибка запуска: либо задать секрет, либо явно RECAPTCHA_DISABLED=true.
RECAPTCHA_PUBLIC=
RECAPTCHA_SECRET=
RECAPTCHA_DISABLED=false

# --- SMTP (почта) ---
MAIL_FROM=no-reply@example.com
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Точность валют (знаков после запятой) ---
REAL_DECIMALS=2
VIRTUAL_DECIMALS=2
INGAME_DECIMALS=2

# --- Docker: MariaDB + домены для nginx-профиля ---
MYSQL_DATABASE=unicore
MYSQL_USER=unicore
MYSQL_PASSWORD=CHANGE_ME_strong_db_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
CLIENT_HOST=example.com
ADMIN_HOST=admin.example.com
SERVER_HOST=api.example.com

# --- Опциональные интеграции (заполнять по необходимости) ---
# Платёжные провайдеры: UNITPAY_*, FREEKASSA_*, ENOTIO_*, PAYOK_*, ANYPAY_*, CENTAPP_*
# Мониторинги голосований: MCTOP_*, MCRATE_*, TOPCRAFT_*, MINECRAFTRATING_*
# Соцсети/аналитика: VK_APIKEY, DISCORD_CLIENT_ID/SECRET, GOOGLE_ANALYTICS_ID, YANDEX_METRIKA_ID
# Публикация новостей в соцсети:
#   Discord — адрес вебхука канала задаётся в админке, дополнительных переменных не нужно.
#   Telegram — TELEGRAM_BOT_TOKEN от @BotFather; бот должен быть администратором канала,
#              сам канал (@name или -100…) указывается в настройках вебхука.
#   VK — VK_APIKEY должен быть токеном сообщества с правом wall, ID сообщества указывается в вебхуке.
# TELEGRAM_BOT_TOKEN=

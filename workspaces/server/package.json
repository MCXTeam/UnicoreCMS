    "jszip": "^3.10.1",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "moment-range": "^4.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.24.2",
    "nodemailer": "^9.1.0",
    "otpauth": "^9.5.1",
    "passport": "^0.7.0",
    "passport-headerapikey": "^1.2.2",

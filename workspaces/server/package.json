  "main": "./dist/main.js",
  "bin": {
    "unicore": "dist/cli/main.js"
  },
  "scripts": {
    "build": "node ./build.js",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node .",
    "dev": "nest start --watch --preserveWatchOutput",
    "typeorm:cli": "typeorm -d ./dist/ormconfig-schema.js",
    "schema:sync": "pnpm run typeorm:cli schema:sync",
    "seed:run": "node dist/cli/main.js seed",
    "migrate:status": "node ./dist/migrations/cli.js status",
    "schema:align": "node ./dist/migrations/cli.js align",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {

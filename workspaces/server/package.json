  "main": "./dist/main.js",
  "bin": {
    "unicore": "dist/cli/main.js"
  },
  "scripts": {
    "build": "node ./build.js",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node .",
    "dev": "nest start --watch --preserveWatchOutput",
    "typeorm:cli": "typeorm -d ./dist/ormconfig-schema.js",
    "money:decimal": "node ./dist/migrations/money-decimal.js",
    "schema:sync": "pnpm run money:decimal && pnpm run typeorm:cli schema:sync",
    "seed:run": "node dist/cli/main.js seed"
  },

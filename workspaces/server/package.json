    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/proxy-addr": "^2.0.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/semver": "^7.7.1",

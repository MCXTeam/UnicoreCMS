{
  "name": "unicore-common",
  "version": "1.2.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./public-config": {
      "types": "./dist/public-config.d.ts",
      "import": "./dist/public-config.mjs",
      "require": "./dist/public-config.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "import": "./dist/ports.mjs",
      "require": "./dist/ports.js"
    },
    "./duration": {
      "types": "./dist/duration.d.ts",
      "import": "./dist/duration.mjs",
      "require": "./dist/duration.js"
    },
    "./timezone": {
      "types": "./dist/timezone.d.ts",
      "import": "./dist/timezone.mjs",
      "require": "./dist/timezone.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "import": "./dist/permissions.mjs",
      "require": "./dist/permissions.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.mjs",
      "require": "./dist/dashboard.js"
    },
    "./users": {
      "types": "./dist/users.d.ts",
      "import": "./dist/users.mjs",
      "require": "./dist/users.js"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "import": "./dist/locales.mjs",
      "require": "./dist/locales.js"
    },
    "./envconfig": {
      "types": "./dist/envconfig.d.ts",
      "import": "./dist/envconfig.mjs",
      "require": "./dist/envconfig.js"
    },
    "./enums": {
      "types": "./dist/enums/index.d.ts",
      "import": "./dist/enums/index.mjs",
      "require": "./dist/enums/index.js"
    },
    "./issuance": {
      "types": "./dist/issuance/index.d.ts",
      "import": "./dist/issuance/index.mjs",
      "require": "./dist/issuance/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.mjs",
      "require": "./dist/validation/index.js"
    },
    "./sanitize": {
      "types": "./dist/sanitize.d.ts",
      "import": "./dist/sanitize.mjs",
      "require": "./dist/sanitize.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.mjs",
      "require": "./dist/build.js"
    },
    "./console": {
      "types": "./dist/console/index.d.ts",
      "import": "./dist/console/index.mjs",
      "require": "./dist/console/index.js"
    },
    "./dist/*": "./dist/*.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "format": "prettier --write --list-different ."
  },
  "dependencies": {
    "cli-color": "^2.0.4",
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "fast-safe-stringify": "^2.1.1",
    "logform": "^2.7.0",
    "nest-winston": "^1.10.2",
    "validator": "^13.15.35",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cli-color": "^2.0.6",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1"
  }
